<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصتي الرقمية - محتوى تقني ومرئي</title>
    <link rel="stylesheet" href="style.css">
    <!-- يمكنك استبدال الرابط أدناه بكود ربط أدسنس الخاص بك لاحقاً -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
</head>
<body>

    <!-- الهيدر أو شريط التنقل -->
    <header>
        <div class="container">
            <h1 class="logo">موقعي الرقمي</h1>
            <nav>
                <ul>
                    <li><a href="#home">الرئيسية</a></li>
                    <li><a href="#about">من نحن</a></li>
                    <li><a href="#contact">اتصل بنا</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- القسم الرئيسي -->
    <section id="home" class="hero">
        <div class="container">
            <h2>مرحباً بك في بوابتي الرقمية</h2>
            <p>نقدم لك محتوى مرئي وتثقيفي مميز يغطي أحدث التقنيات والمواضيع الشائعة. تابع قناتنا على يوتيوب واستمتع بأحدث الفيديوهات.</p>
            <a href="https://youtube.com" target="_blank" class="btn">زيارة قناتنا على يوتيوب</a>
        </div>
    </section>

    <!-- قسم من نحن -->
    <section id="about" class="about">
        <div class="container">
            <h2>من نحن</h2>
            <p>نحن منصة مهتمة بتقديم محتوى رقمي عالي الجودة ومفيد للمجتمع العربي. نسعى دائماً لتبسيط المعلومة وتقديمها بطريقة احترافية وسهلة الفهم للجميع.</p>
        </div>
    </section>

    <!-- قسم سياسة الخصوصية (مهم جداً لأدسنس) -->
    <section id="privacy" class="privacy">
        <div class="container">
            <h2>سياسة الخصوصية</h2>
            <p>نحن في هذا الموقع نولي اهتماماً بالغاً بخصوصية زوارنا. توضح وثيقة سياسة الخصوصية هذه أنواع المعلومات الشخصية التي يتم جمعها وكيفية استخدامها. نحن نستخدم ملفات تعريف الارتباط (Cookies) لتحسين تجربة المستخدم وعرض الإعلانات المناسبة عبر Google AdSense.</p>
        </div>
    </section>

    <!-- قسم اتصل بنا -->
    <section id="contact" class="contact">
        <div class="container">
            <h2>اتصل بنا</h2>
            <p>يسعدنا تواصلك معنا لأي استفسار أو اقتراح عبر البريد الإلكتروني: <a href="mailto:info@yourdomain.com">info@yourdomain.com</a></p>
        </div>
    </section>

    <!-- الفوتر -->
    <footer>
        <div class="container">
            <p>&copy; 2026 جميع Rights Reserved. موقعي الرقمي.</p>
        </div>
    </footer>

