* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f9f9f9;
    color: #333;
    line-height: 1.6;
}

.container {
    width: 85%;
    max-width: 1100px;
    margin: auto;
    overflow: hidden;
}

header {
    background: #ffffff;
    padding: 20px 0;
    border-bottom: 1px solid #eaeaea;
    position: sticky;
    top: 0;
    z-index: 1000;
}

header .logo {
    float: right;
    color: #2c3e50;
    font-size: 24px;
}

header nav {
    float: left;
}

header nav ul {
    list-style: none;
}

header nav ul li {
    display: inline;
    margin-left: 20px;
}

header nav ul li a {
    text-decoration: none;
    color: #555;
    font-weight: 600;
    transition: color 0.3s;
}

header nav ul li a:hover {
    color: #e74c3c;
}

.hero {
    background: linear-gradient(135deg, #2c3e50, #3498db);
    color: #fff;
    padding: 100px 0;
    text-align: center;
}

.hero h2 {
    font-size: 36px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 30px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
}

.btn {
    display: inline-block;
    background: #e74c3c;
    color: #fff;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    transition: background 0.3s;
}

.btn:hover {
    background: #c0392b;
}

section {
    padding: 60px 0;
    background: #fff;
    margin-bottom: 10px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

section h2 {
    margin-bottom: 20px;
    color: #2c3e50;
}

footer {
    text-align: center;
    padding: 20px 0;
    background: #2c3e50;
    color: #fff;
    margin-top: 20px;
}
